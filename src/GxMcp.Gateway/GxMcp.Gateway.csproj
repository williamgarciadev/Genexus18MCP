<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The "18" is the GeneXus major this server targets, and it is here so the running
         process is identifiable at a glance: a machine can host this alongside the GeneXus 16
         server (Gx16Mcp.*), and Task Manager shows the image name and nothing else.
         The project, namespaces and test assemblies keep the GxMcp.* names — only the produced
         binary is renamed. SelfUpdater accepts both names so installs on the old name can still
         update themselves; see the compatibility note there. -->
    <AssemblyName>GxMcp18.Gateway</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.41.3</Version>
    <AssemblyVersion>2.41.3.0</AssemblyVersion>
    <FileVersion>2.41.3.0</FileVersion>
    <InformationalVersion>2.41.3</InformationalVersion>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!-- PERFORMANCE (build flags): enable ReadyToRun for Release publish. This pre-compiles
       hot methods to native code at publish time, eliminating most JIT cost on cold start.
       Safe with reflection (GeneXus SDK is in the Worker, not here). Only kicks in for
       `dotnet publish -c Release`; debug builds are untouched. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GxMcp.Gateway.Tests" />
    <InternalsVisibleTo Include="GxMcp.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Management" Version="10.0.5" />
    <PackageReference Include="System.Security.Permissions" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\config.sample.json" Link="config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Content Update="tool_definitions.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
